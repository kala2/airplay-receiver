/third_party/

# --- Build outputs ---
.gradle/
.kotlin/
build/
.cxx/
.externalNativeBuild/
captures/
*.apk
*.aab

# --- IDE / OS ---
.idea/
*.iml
.vscode/
.DS_Store

# --- Claude Code local session data ---
.claude/

# --- Release tooling (installed on the fly in CI; never committed) ---
node_modules/
package.json
package-lock.json
/dist/
